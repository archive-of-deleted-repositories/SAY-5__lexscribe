FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

FROM base AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md LICENSE ./
COPY packages ./packages
COPY services ./services
RUN pip install --user --no-warn-script-location .

FROM base AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 lex
COPY --from=builder /root/.local /home/lex/.local
COPY packages ./packages
COPY services ./services
COPY pyproject.toml README.md LICENSE ./
ENV PATH=/home/lex/.local/bin:$PATH \
    PYTHONPATH=/app/packages/shared:/app/packages/retrieval:/app/packages/eval:/app/packages/clients/python:/app/services/api:/app/services/ingest-worker
USER lex
CMD ["celery", "-A", "lexscribe_worker.app", "worker", "-l", "info", "-Q", "parse,embed,classify"]
